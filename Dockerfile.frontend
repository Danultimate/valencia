FROM node:20-alpine AS builder

WORKDIR /app

COPY frontend/package.json ./
RUN npm install

COPY frontend/ .

ARG VITE_SCRAPE_API_KEY
ENV VITE_SCRAPE_API_KEY=$VITE_SCRAPE_API_KEY

RUN npm run build

FROM nginx:1.27-alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY frontend/nginx.conf /tmp/nginx.conf.template

ENV PORT=80
ENV API_URL=http://fastapi:8000

EXPOSE 80

CMD ["/bin/sh", "-c", "envsubst '${PORT} ${API_URL}' < /tmp/nginx.conf.template > /etc/nginx/conf.d/default.conf && exec nginx -g 'daemon off;'"]
