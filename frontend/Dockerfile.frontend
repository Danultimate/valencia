FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json ./
RUN npm install

COPY . .

ARG VITE_SCRAPE_API_KEY
ENV VITE_SCRAPE_API_KEY=$VITE_SCRAPE_API_KEY

RUN npm run build

FROM nginx:1.27-alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/templates/default.conf.template

# PORT defaults to 80 for docker-compose (Hostinger), Railway overrides it
ENV PORT=80
ENV API_URL=http://fastapi:8000

EXPOSE 80

CMD ["/bin/sh", "-c", "envsubst '${PORT} ${API_URL}' < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]
