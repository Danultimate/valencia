FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json ./
RUN npm install

COPY . .

ARG VITE_SCRAPE_API_KEY
ENV VITE_SCRAPE_API_KEY=$VITE_SCRAPE_API_KEY

RUN npm run build

FROM nginx:1.27-alpine

COPY --from=builder /app/dist /usr/share/nginx/html
# Keep template outside /etc/nginx/templates/ — the nginx entrypoint would run
# envsubst on ALL env vars there, corrupting nginx variables like $host and $uri.
COPY nginx.conf /tmp/nginx.conf.template

# PORT defaults to 80 for docker-compose; Railway overrides it at runtime
ENV PORT=80
ENV API_URL=http://fastapi:8000

EXPOSE 80

CMD ["/bin/sh", "-c", "envsubst '${PORT} ${API_URL}' < /tmp/nginx.conf.template > /etc/nginx/conf.d/default.conf && exec nginx -g 'daemon off;'"]
