# PostgreSQL
POSTGRES_DB=valencia_auctions
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# API
SCRAPE_API_KEY=changeme-secret-key

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Scraping
SCRAPE_INTERVAL_SECONDS=5400
SCRAPE_POLITE_DELAY_SECONDS=2
TARGET_URL=https://www.onlineveilingmeester.nl

# Frontend (build-time — set in frontend/.env or pass as build arg)
VITE_SCRAPE_API_KEY=changeme-secret-key
